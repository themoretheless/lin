+
+// Explicit storage API selection belongs to setup/reopen, never operation timing.
+fn open_combined_db(path: &std::path::Path, sync: lin::SyncMode) -> lin::Db {
+    #[cfg(feature = "experimental-extent-wal")]
+    if matches!(sync, lin::SyncMode::Full) {
+        let db = lin::Db::open_extent(path, 16 * 1024 * 1024).unwrap();
+        assert!(db.is_durable());
+        assert!(!db.stats().sync_normal);
+        assert_eq!(std::fs::metadata(lin::persist::log_path(path)).unwrap().len(), 16 * 1024 * 1024);
+        return db;
+    }
+    let db = lin::Db::open_with(path, lin::OpenOpts { sync, cold: false }).unwrap();
+    assert!(db.is_durable());
+    db
+}
